{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs && pnpm run test:sue",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:sue": "node ./scripts/test-sue-applicability.mjs",
    "benchmark:sue": "node ./scripts/benchmark-sue-accuracy.mjs",
    "benchmark:sue:live": "node ./scripts/benchmark-sue-live.mjs",
    "benchmark:sue:policies": "node ./scripts/benchmark-sue-vibecoded.mjs",
    "build:agentshield": "node ./scripts/build-agentshield.mjs",
    "test:agentshield": "node --test ./scripts/test-agentshield.mjs",
    "test:agentshield:week2": "node --test ./scripts/test-agentshield-week2.mjs",
    "test:agentshield:week3": "node --test ./scripts/test-agentshield-week3.mjs",
    "vibesane": "node ./scripts/vibesane.mjs",
    "test:agentshield:week4": "node --test ./scripts/test-agentshield-week4.mjs",
    "benchmark:agentshield": "node ./scripts/benchmark-agentshield-accuracy.mjs",
    "package:agentshield:beta": "node ./scripts/package-agentshield-beta.mjs",
    "test:agentshield:week5": "node --test ./scripts/test-agentshield-week5.mjs",
    "test:agentshield:hybrid": "node --test ./scripts/test-agentshield-hybrid.mjs",
    "test:agentshield:ast": "node --test ./scripts/test-agentshield-ast.mjs",
    "benchmark:agentshield:ast": "node ./scripts/benchmark-agentshield-ast.mjs",
    "test:agentshield:taint": "node --test ./scripts/test-agentshield-taint.mjs",
    "test:agentshield:release": "node --test ./scripts/test-agentshield-release.mjs ./scripts/test-agentshield-models.mjs ./scripts/test-scan-score.mjs",
    "benchmark:agentshield:taint": "node ./scripts/benchmark-agentshield-taint.mjs",
    "test:vibesane:check-output": "node --test ./scripts/test-vibesane-checks.mjs",
    "test:agentshield:phase12": "node --test ./scripts/test-agentshield-phase12.mjs ./scripts/test-agentshield-crossfile.mjs ./scripts/test-agentshield-route-auth.mjs ./scripts/test-agentshield-supabase-policy.mjs ./scripts/test-agentshield-auth-regression.mjs ./scripts/test-vibesane-sql-context.mjs ./scripts/test-phase1-github-http-contract.mjs ./scripts/test-phase1-crypto.mjs ./scripts/test-phase1-dodo-environment.mjs ./scripts/test-phase1-dodo-signature.mjs ./scripts/test-phase1-dodo-sync-http.mjs ./scripts/test-staging-access.mjs ./scripts/test-phase1-dodo-webhook-retry.mjs ./scripts/test-phase1-github-installation-ownership.mjs ./scripts/test-password-storage-scanner.mjs ./scripts/test-public-scan-allowance-http.mjs ./scripts/test-scan-failure-isolation-http.mjs ./scripts/test-phase1-github-oauth-handoff.mjs ./scripts/test-scan-repository-url-http.mjs ./scripts/test-vibesane-v2-context.mjs ./scripts/test-phase1-staging-isolation.mjs",
    "benchmark:agentshield:phase2": "node ./scripts/benchmark-agentshield-phase2.mjs",
    "benchmark:agentshield:phase2:performance": "node ./scripts/benchmark-agentshield-phase2-performance.mjs",
    "test:agentshield:phase1:http": "node --test ./scripts/test-phase1-github-http-contract.mjs",
    "benchmark:agentshield:models": "node ./scripts/benchmark-agentshield-models.mjs",
    "test:agentshield:models": "node --test ./scripts/test-agentshield-models.mjs",
    "test:scan-score": "node --test ./scripts/test-scan-score.mjs",
    "agentshield:mcp": "node ./scripts/agentshield-mcp-server.mjs",
    "test:agentshield:mcp": "node --test ./scripts/test-agentshield-mcp.mjs ./scripts/test-agentshield-python.mjs ./scripts/test-agentshield-gate.mjs",
    "test:agentshield:python": "node --test ./scripts/test-agentshield-python.mjs",
    "test:agentshield:gate": "node --test ./scripts/test-agentshield-gate.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "@supabase/supabase-js": "^2.110.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
