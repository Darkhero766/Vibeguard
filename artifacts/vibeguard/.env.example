# Supabase browser configuration.
# Use the Replit Secrets named below for local/hosted runs.
# Never put a Supabase service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase direct Postgres connection (used by the API server for github_tokens).
# Set this as a Replit Secret named SUPABASE_DB_URL.
SUPABASE_DB_URL=postgresql://postgres:your_database_password@your-db-host:5432/postgres
