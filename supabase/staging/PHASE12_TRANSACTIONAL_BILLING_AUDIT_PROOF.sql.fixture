-- STAGING ONLY, synthetic billing + audit DB contract, transaction rollback.
-- Not a Dodo API/sandbox transaction, a signed webhook or a deployed HTTP test.
BEGIN;
INSERT INTO auth.users (id,aud,role,email,created_at,updated_at,is_sso_user,is_anonymous)
VALUES ('c0330000-731e-4bc0-8300-000000000001','authenticated','authenticated','billing-contract-test@example.invalid',now(),now(),false,false),
 ('c0330000-731e-4bc0-8300-000000000002','authenticated','authenticated','another-contract-test@example.invalid',now(),now(),false,false);
SET LOCAL ROLE service_role;
UPDATE public.usage SET
  plan='pro', scans_limit=100, monthly_scans_limit=100,
  dodo_customer_id='test-only-customer', dodo_subscription_id='test-only-subscription',
  dodo_subscription_status='active'
WHERE owner='c0330000-731e-4bc0-8300-000000000001'::uuid;
INSERT INTO public.dodo_webhook_events(webhook_id,event_type,payload)
VALUES ('synthetic-dodo-idempotency','subscription.active','{"source":"synthetic-staging"}'::jsonb);
INSERT INTO public.dodo_webhook_events(webhook_id,event_type,payload)
VALUES ('synthetic-dodo-idempotency','subscription.active','{"source":"synthetic-staging"}'::jsonb)
ON CONFLICT (webhook_id) DO NOTHING;
INSERT INTO public.audit_runs(owner,url,scanned_at,score)
VALUES ('c0330000-731e-4bc0-8300-000000000001'::uuid,'https://example.invalid/old',now()-interval '91 days',85);
INSERT INTO public.audit_runs(owner,url,scanned_at,score)
VALUES ('c0330000-731e-4bc0-8300-000000000001'::uuid,'https://example.invalid/new',now(),91);
DO $$
DECLARE n integer;
BEGIN
 SELECT count(*) INTO n FROM public.dodo_webhook_events
  WHERE webhook_id='synthetic-dodo-idempotency';
 IF n<>1 THEN RAISE EXCEPTION 'Dodo webhook idempotency broken'; END IF;
 SELECT count(*) INTO n FROM public.audit_runs
  WHERE owner='c0330000-731e-4bc0-8300-000000000001'::uuid;
 IF n<>1 THEN RAISE EXCEPTION 'Audit retention trigger failed; count %',n; END IF;
 IF NOT EXISTS (SELECT 1 FROM public.usage
   WHERE owner='c0330000-731e-4bc0-8300-000000000001'::uuid AND plan='pro'
   AND scans_limit=100 AND dodo_subscription_id='test-only-subscription')
 THEN RAISE EXCEPTION 'Server-owned billing entitlement update failed'; END IF;
END $$;
RESET ROLE;

SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub','c0330000-731e-4bc0-8300-000000000001',true);
DO $$
DECLARE n integer;
BEGIN
 SELECT count(*) INTO n FROM public.audit_runs;
 IF n<>1 THEN RAISE EXCEPTION 'Owner audit history is not accessible'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.usage
   WHERE owner='c0330000-731e-4bc0-8300-000000000001'::uuid AND plan='pro' AND monthly_scans_limit=100)
 THEN RAISE EXCEPTION 'Owner cannot read updated Pro entitlement'; END IF;
 BEGIN
   UPDATE public.usage SET plan='free' WHERE owner='c0330000-731e-4bc0-8300-000000000001'::uuid;
   RAISE EXCEPTION 'Client can change billing state';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $$;
RESET ROLE;
SELECT 'staging_billing_audit_contract_passed_rolled_back' AS status;
ROLLBACK;
