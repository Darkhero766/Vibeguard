-- STAGING ONLY, non-deployable transactional proof; no persistent changes.
-- Do not run on production. Run against existing isolated staging with 9 tables.
BEGIN;
GRANT ALL PRIVILEGES ON TABLE public.usage TO PUBLIC, anon, authenticated;
GRANT ALL PRIVILEGES ON TABLE public.github_tokens TO PUBLIC, anon, authenticated;
GRANT ALL PRIVILEGES ON TABLE public.audit_runs TO PUBLIC, anon, authenticated;
CREATE POLICY "Users can update their own usage" ON public.usage
 FOR UPDATE TO PUBLIC USING ((SELECT auth.uid())=owner) WITH CHECK ((SELECT auth.uid())=owner);
CREATE POLICY "Users can insert their own usage" ON public.usage
 FOR INSERT TO PUBLIC WITH CHECK ((SELECT auth.uid())=owner);
CREATE POLICY "Users can manage their own github token" ON public.github_tokens
 FOR ALL TO PUBLIC USING ((SELECT auth.uid())=owner) WITH CHECK ((SELECT auth.uid())=owner);
DO $$ BEGIN
 IF NOT has_table_privilege('authenticated','public.usage','UPDATE')
 OR NOT has_table_privilege('authenticated','public.github_tokens','SELECT')
 OR NOT has_table_privilege('authenticated','public.audit_runs','INSERT')
 THEN RAISE EXCEPTION 'Legacy permission preparation failed'; END IF;
END $$;
-- Apply exact reviewed candidate bodies, without their BEGIN/COMMIT wrappers.
REVOKE ALL PRIVILEGES ON TABLE public.usage FROM PUBLIC, anon, authenticated;
GRANT SELECT ON TABLE public.usage TO authenticated;
DROP POLICY IF EXISTS "Users can update their own usage" ON public.usage;
DROP POLICY IF EXISTS "Users can insert their own usage" ON public.usage;
REVOKE ALL PRIVILEGES ON TABLE public.github_tokens FROM PUBLIC, anon, authenticated;
DROP POLICY IF EXISTS "Users can manage their own github token" ON public.github_tokens;
ALTER TABLE public.github_tokens ENABLE ROW LEVEL SECURITY;

REVOKE ALL PRIVILEGES ON TABLE public.audit_runs FROM PUBLIC, anon, authenticated;
GRANT SELECT ON TABLE public.audit_runs TO authenticated;
-- Assert all eleven post-migration security checks return true.
SELECT 'usage_authenticated_insert_revoked' AS gate,
       NOT has_table_privilege('authenticated','public.usage','INSERT') AS passed
UNION ALL
SELECT 'usage_authenticated_update_revoked',
       NOT has_table_privilege('authenticated','public.usage','UPDATE')
UNION ALL
SELECT 'usage_authenticated_select_maintained',
       has_table_privilege('authenticated','public.usage','SELECT')
UNION ALL
SELECT 'token_authenticated_select_revoked',
       NOT has_table_privilege('authenticated','public.github_tokens','SELECT')
UNION ALL
SELECT 'token_authenticated_write_revoked',
       NOT (has_table_privilege('authenticated','public.github_tokens','INSERT')
            OR has_table_privilege('authenticated','public.github_tokens','UPDATE')
            OR has_table_privilege('authenticated','public.github_tokens','DELETE'))
UNION ALL
SELECT 'token_anon_access_revoked',
       NOT (has_table_privilege('anon','public.github_tokens','SELECT')
            OR has_table_privilege('anon','public.github_tokens','INSERT')
            OR has_table_privilege('anon','public.github_tokens','UPDATE')
            OR has_table_privilege('anon','public.github_tokens','DELETE'))
UNION ALL
SELECT 'audit_authenticated_write_revoked',
       NOT (has_table_privilege('authenticated','public.audit_runs','INSERT')
            OR has_table_privilege('authenticated','public.audit_runs','UPDATE')
            OR has_table_privilege('authenticated','public.audit_runs','DELETE'))
UNION ALL
SELECT 'audit_authenticated_select_maintained',
       has_table_privilege('authenticated','public.audit_runs','SELECT')
UNION ALL
SELECT 'usage_owner_write_policies_removed',
       NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='public'
         AND tablename='usage' AND cmd IN ('INSERT','UPDATE','ALL'))
UNION ALL
SELECT 'token_client_policies_removed',
       NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='public'
         AND tablename='github_tokens' AND cmd IN ('ALL','SELECT','INSERT','UPDATE','DELETE'))
UNION ALL
SELECT 'rls_enabled_all_three_tables',
       (SELECT COUNT(*)=3 FROM pg_class c
          JOIN pg_namespace n ON n.oid=c.relnamespace
          WHERE n.nspname='public' AND c.relname IN ('usage','github_tokens','audit_runs')
          AND c.relrowsecurity);
ROLLBACK;
