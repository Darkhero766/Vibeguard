-- Synthetic verification on CI PostgreSQL ONLY. Never execute on hosted Supabase.
\set ON_ERROR_STOP on
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE SCHEMA auth;
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE SQL STABLE
AS $f$ SELECT NULLIF(current_setting('request.jwt.claim.sub', true),'')::uuid; $f$;
GRANT USAGE ON SCHEMA public TO anon, authenticated;
GRANT USAGE ON SCHEMA auth TO anon, authenticated;
GRANT EXECUTE ON FUNCTION auth.uid() TO anon, authenticated;
CREATE TABLE public.github_tokens (
 owner uuid PRIMARY KEY, encrypted_token text NOT NULL, created_at timestamptz DEFAULT now()
);
CREATE TABLE public.audit_runs (
 id uuid PRIMARY KEY, owner uuid NOT NULL, score integer NOT NULL DEFAULT 0
);
ALTER TABLE public.github_tokens ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.audit_runs ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can manage their own github token" ON public.github_tokens
FOR ALL USING ((select auth.uid())=owner) WITH CHECK ((select auth.uid())=owner);
CREATE POLICY audit_runs_select_own ON public.audit_runs FOR SELECT
TO authenticated USING ((select auth.uid())=owner);
GRANT ALL PRIVILEGES ON public.github_tokens, public.audit_runs TO anon,authenticated;

-- Before fix: client can read their own encrypted credential record.
INSERT INTO public.github_tokens(owner,encrypted_token)
VALUES('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','SYNTHETIC_CIPHERTEXT');
INSERT INTO public.audit_runs(id,owner)
VALUES('10000000-0000-4000-8000-000000000001','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'),
      ('10000000-0000-4000-8000-000000000002','bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb');
SET ROLE authenticated;
SET request.jwt.claim.sub='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
DO $$
BEGIN
 IF (SELECT COUNT(*) FROM public.github_tokens)!=1 THEN
   RAISE EXCEPTION 'Test setup: pre-fix client token ciphertext must be readable';
 END IF;
END; $$;
RESET ROLE;

\ir PROPOSED_GITHUB_TOKEN_AUDIT_LOCKDOWN.sql

DO $$
BEGIN
 IF has_table_privilege('authenticated','public.github_tokens','SELECT')
 OR has_table_privilege('authenticated','public.github_tokens','INSERT')
 OR has_table_privilege('authenticated','public.github_tokens','UPDATE')
 OR has_table_privilege('authenticated','public.github_tokens','DELETE')
 OR has_table_privilege('anon','public.github_tokens','SELECT')
 OR has_table_privilege('authenticated','public.audit_runs','UPDATE')
 OR has_table_privilege('authenticated','public.audit_runs','INSERT')
 OR NOT has_table_privilege('authenticated','public.audit_runs','SELECT') THEN
   RAISE EXCEPTION 'Token/audit permissions are not least privilege';
 END IF;
 IF EXISTS (
   SELECT 1 FROM pg_policies WHERE schemaname='public'
     AND tablename='github_tokens'
 ) THEN
   RAISE EXCEPTION 'Client GitHub token policies remain';
 END IF;
END; $$;
SET ROLE authenticated;
SET request.jwt.claim.sub='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
DO $$
DECLARE count_owned integer;
BEGIN
 SELECT COUNT(*) INTO count_owned FROM public.audit_runs;
 IF count_owned!=1 THEN
   RAISE EXCEPTION 'Audit SELECT RLS unexpectedly changed: %', count_owned;
 END IF;
END; $$;
RESET ROLE;
SELECT 'CI_TOKEN_AUDIT_LOCKDOWN_PASSED' AS result;
