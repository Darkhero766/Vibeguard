-- READ-ONLY Phase 1 staging/production verification. Do not use as a migration.
-- Run manually via a privileged read-only database session AFTER the approved
-- compatible API/frontend release and separately approved GRANT changes.
-- Every passed value MUST be true. Fails today in the live production instance.
-- This file contains only catalog lookups; no customer data, write or DDL.
SELECT 'usage_authenticated_insert_revoked' AS gate,
       NOT has_table_privilege('authenticated','public.usage','INSERT') AS passed
UNION ALL
SELECT 'usage_authenticated_update_revoked',
       NOT has_table_privilege('authenticated','public.usage','UPDATE')
UNION ALL
SELECT 'usage_authenticated_select_maintained',
       has_table_privilege('authenticated','public.usage','SELECT')
UNION ALL
SELECT 'token_authenticated_select_revoked',
       NOT has_table_privilege('authenticated','public.github_tokens','SELECT')
UNION ALL
SELECT 'token_authenticated_write_revoked',
       NOT (has_table_privilege('authenticated','public.github_tokens','INSERT')
            OR has_table_privilege('authenticated','public.github_tokens','UPDATE')
            OR has_table_privilege('authenticated','public.github_tokens','DELETE'))
UNION ALL
SELECT 'token_anon_access_revoked',
       NOT (has_table_privilege('anon','public.github_tokens','SELECT')
            OR has_table_privilege('anon','public.github_tokens','INSERT')
            OR has_table_privilege('anon','public.github_tokens','UPDATE')
            OR has_table_privilege('anon','public.github_tokens','DELETE'))
UNION ALL
SELECT 'audit_authenticated_write_revoked',
       NOT (has_table_privilege('authenticated','public.audit_runs','INSERT')
            OR has_table_privilege('authenticated','public.audit_runs','UPDATE')
            OR has_table_privilege('authenticated','public.audit_runs','DELETE'))
UNION ALL
SELECT 'audit_authenticated_select_maintained',
       has_table_privilege('authenticated','public.audit_runs','SELECT')
UNION ALL
SELECT 'usage_owner_write_policies_removed',
       NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='public'
         AND tablename='usage' AND cmd IN ('INSERT','UPDATE','ALL'))
UNION ALL
SELECT 'token_client_policies_removed',
       NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='public'
         AND tablename='github_tokens' AND cmd IN ('ALL','SELECT','INSERT','UPDATE','DELETE'))
UNION ALL
SELECT 'rls_enabled_all_three_tables',
       (SELECT COUNT(*)=3 FROM pg_class c
          JOIN pg_namespace n ON n.oid=c.relnamespace
          WHERE n.nspname='public' AND c.relname IN ('usage','github_tokens','audit_runs')
          AND c.relrowsecurity);
-- Supabase leaked-password protection is an Auth setting, not a SQL grant.
-- Verify separately using the Supabase security advisor UI/API.
-- Manual signoff must also verify service-role server queries and actual
-- account/signup, GitHub OAuth, quota, billing, webhook and audit flows.
